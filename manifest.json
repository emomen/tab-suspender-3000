{
  "manifest_version": 3,
  "name": "Tab Suspender 3000",
  "version": "1.0",
  "description": "List browser windows and tabs; suspend checked tabs.",
  "permissions": [
    "tabs",
    "windows",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tab Suspender 3000"
  }
}
